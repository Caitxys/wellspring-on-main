.env
.env.*
!.env.example

# ---------- Supabase (local CLI) ----------
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*
supabase/seed.local.sql
supabase/snippets/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Caches / test output ----------
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
coverage/
.nyc_output/

# ---------- Deploy platforms ----------
.vercel/
.netlify/

# ---------- Editors / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
