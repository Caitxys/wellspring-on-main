# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Astro build output ----------
dist/
.astro/
.output/

# ---------- Environment variables / secrets ----------
