# Copy this file to .env and fill in the values from
# Supabase dashboard -> Project Settings -> API.
# .env is ignored by Git; this example file is committed.

# Safe to expose to the browser (PUBLIC_ prefix)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
