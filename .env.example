# Copy this file to .env and fill in the values from
# Supabase dashboard -> Project Settings -> API (or "API Keys").
# .env is ignored by Git; this example file is committed.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
PUBLIC_SUPABASE_URL=your-project-url

# The anon / publishable key. It is safe in the browser because
# Row Level Security (database/03_auth_and_permissions.sql) controls access.
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# No service-role (secret) key is needed. Never put one in this project.
