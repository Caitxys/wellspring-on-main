---
// Shell for every staff page: header with who is signed in, main area, footer.
// Feature pages only pass a title; the class names they use live in staff.css.
import '../styles/global.css';
import '../styles/staff.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const staff = Astro.locals.staff;

const initials = staff
  ? staff.full_name
      .split(/\s+/)
      .filter(Boolean)
      .map((part: string) => part[0])
      .slice(0, 2)
      .join('')
      .toUpperCase()
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Wellspring Staff</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body class="staff">
    <a href="#main" class="skip-link">Skip to main content</a>

    <header class="staff-header">
      <div class="staff-wrap staff-header-row">
        <a href={staff ? '/staff' : '/'} class="staff-brand">
          <span class="staff-brand-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c3 4 5 6.5 5 9.5a5 5 0 0 1-10 0C7 9.5 9 7 12 3z"></path></svg>
          </span>
          <span class="staff-brand-text">
            <span class="staff-brand-name">Wellspring on Main</span>
            <span class="staff-brand-tag">Staff portal</span>
          </span>
        </a>
        {
          staff && (
            <div class="who">
              <span class="who-avatar" aria-hidden="true">{initials}</span>
              <span class="who-text">
                <span class="who-name">{staff.full_name}</span>
                <span class="role-tag">{staff.role}</span>
              </span>
              <form method="post" action="/api/auth/logout">
                <button type="submit" class="btn btn-secondary btn-sm">Sign out</button>
              </form>
            </div>
          )
        }
      </div>
    </header>

    <main id="main" class="staff-wrap staff-main">
      <slot />
    </main>

    <footer class="staff-footer">
      <div class="staff-wrap staff-footer-row">
        <span>Wellspring on Main · Staff portal</span>
        <a href="/">View the public website</a>
      </div>
    </footer>
  </body>
</html>
