---
import Layout from '../layouts/Layout.astro';

const SITE = 'https://www.wellspringonmain.org';

const eventTypes = [
  'Weddings',
  'Corporate events',
  'Retreats',
  'Conferences',
  'Birthday parties',
  'Cultural celebrations',
  'Nonprofit events',
  'Community gatherings',
];
---

<Layout title="Wellspring on Main — Home">
  <!-- Hero -->
  <section id="top" class="hero">
    <div class="container">
      <div class="hero-copy">
        <span class="pill">A community oasis in Downtown Arlington</span>
        <h1>Gather, connect and grow at the well.</h1>
        <p class="lead">
          Like the water wells that have long brought communities together, Wellspring on Main is a
          gathering place that supports the physical, emotional and spiritual health of our neighbors,
          honoring the dignity of every person who walks through the door.
        </p>
        <div class="actions">
          <a href="#rentals" class="btn btn-lg btn-primary">Explore rental options</a>
          <a href="#about" class="btn btn-lg btn-secondary">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M10 8.5l5 3.5-5 3.5z"></path></svg>
            Watch our story
          </a>
        </div>
      </div>
      <div class="hero-media">
        <div role="img" aria-label="Photo placeholder: the Wellspring on Main building" class="placeholder hero-photo">
          <svg aria-hidden="true" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><circle cx="9" cy="10" r="2"></circle><path d="M21 16l-5-5-8 8"></path></svg>
          <span>[Photo: Wellspring on Main exterior or event space]</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick facts -->
  <section aria-label="At a glance" class="facts">
    <div class="container">
      <div class="fact">
        <span class="icon-tile"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V9l7-5 7 5v12"></path><path d="M10 21v-6h4v6"></path></svg></span>
        <div><div class="fact-title">Flexible event spaces</div><div class="fact-body">Customizable rooms with professional amenities</div></div>
      </div>
      <div class="fact">
        <span class="icon-tile"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"></circle><circle cx="17" cy="9" r="2.5"></circle><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"></path><path d="M15 14.5c2.9 0 5 2.2 5 5"></path></svg></span>
        <div><div class="fact-title">Community programs</div><div class="fact-body">Projects shaped with and for Arlington</div></div>
      </div>
      <div class="fact">
        <span class="icon-tile"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span>
        <div><div class="fact-title">Heart of downtown</div><div class="fact-body">201 W. Main St., Arlington, TX</div></div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="about">
    <div class="container">
      <div class="about-head">
        <span class="eyebrow">About Wellspring</span>
        <h2>A place to draw from, and to give back to.</h2>
      </div>
      <div class="about-body">
        <p>
          Wellspring on Main is run by the Arlington Center for Community Engagement, Inc. For
          generations, the village well has been where people meet, share news and look after one
          another. We are building that same kind of place in the middle of Downtown Arlington.
        </p>
        <p>
          Whether you're planning a celebration, hosting a workshop, or looking for ways to get
          involved, there's room for you here.
        </p>
        <a href={`${SITE}/faqs`} class="text-link">
          Read the FAQs
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Ways to engage -->
  <section id="programs" class="programs">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ways to engage</span>
        <h2 class="h2">Find your place at Wellspring</h2>
        <p class="lead">Rent a space, join a project, or roll up your sleeves with neighbors.</p>
      </div>
      <div class="card-grid">
        <article id="rentals" class="card">
          <div role="img" aria-label="Photo placeholder: event space set up for a gathering" class="placeholder">[Photo: event space]</div>
          <div class="card-body">
            <h3>Rental options</h3>
            <p>Customizable spaces with professional amenities and a warm atmosphere for events of every size.</p>
            <a href={`${SITE}/services-4`} class="btn btn-primary">View spaces</a>
          </div>
        </article>

        <article class="card">
          <div role="img" aria-label="Photo placeholder: community members in conversation" class="placeholder tone-coral">[Photo: community conversation]</div>
          <div class="card-body">
            <h3>Programs + Projects</h3>
            <p>
              Our first project, <strong>Gathering at the Wellspring: A Vision for Arlington's Future</strong>,
              invites the community to imagine what comes next.
            </p>
            <a href={`${SITE}/projects-1`} class="btn btn-secondary">See the project</a>
          </div>
        </article>

        <article class="card">
          <div role="img" aria-label="Photo placeholder: volunteers working together" class="placeholder tone-gray">[Photo: volunteers]</div>
          <div class="card-body">
            <h3>Community-spirited activities</h3>
            <p>Hands-on ways to care for downtown and connect with your neighbors.</p>
            <a href={`${SITE}/general-clean`} class="btn btn-secondary">Get involved</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Host your event -->
  <section class="events">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Host your event</span>
        <h2 class="h2">Room for every kind of gathering</h2>
      </div>
      <ul aria-label="Event types" class="chips">
        {eventTypes.map((t) => <li>{t}</li>)}
      </ul>
      <div class="gallery">
        <div role="img" aria-label="Gallery photo placeholder" class="placeholder">[Gallery photo]</div>
        <div role="img" aria-label="Gallery photo placeholder" class="placeholder tone-teal-dark">[Gallery photo]</div>
        <div role="img" aria-label="Gallery photo placeholder" class="placeholder">[Gallery photo]</div>
      </div>
      <a href={`${SITE}/gallery`} class="text-link">
        Browse the gallery
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </section>

  <!-- Testimonial -->
  <section aria-label="Testimonial" class="testimonial">
    <div class="container">
      <svg aria-hidden="true" width="40" height="40" viewBox="0 0 24 24" fill="#f7a585"><path d="M7 7h4v4c0 3-1.5 5-4 6l-.8-1.4C7.6 14.8 8.3 13.6 8.4 12H7zm8 0h4v4c0 3-1.5 5-4 6l-.8-1.4c1.4-.8 2.1-2 2.2-3.6H15z"></path></svg>
      <p class="quote">[Testimonial quote from a recent guest or partner, pulled from the Testimonials page.]</p>
      <p class="attribution">[Name] · [Event type]</p>
      <a href={`${SITE}/testimonials`} class="btn btn-white">Read more testimonials</a>
    </div>
  </section>

  <!-- Visit / CTA -->
  <section>
    <div class="container">
      <div class="cta">
        <div class="cta-copy">
          <h2 class="h2">Planning something? Let's talk.</h2>
          <p>Tell us about your event or idea and we'll help you find the right space at 201 W. Main St.</p>
        </div>
        <div class="actions">
          <a href={`${SITE}/contact-us`} class="btn btn-lg btn-coral">Contact us</a>
          <a href="https://www.google.com/maps/search/?api=1&query=201+W+Main+St+Arlington+TX" class="btn btn-lg btn-secondary">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
            Get directions
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
